# ─────────────────────────────────────────────────────────────────────────────
# ROIstation Master Panel — environment variables
# Copy to .env.local for development. On Vercel, add them under Project → Settings
# → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin access (required) ──────────────────────────────────────────────────
PANEL_ADMIN_PASSWORD=
# At least 32 characters. Also derives the AES-256-GCM keys for stored tokens:
# rotating it signs everyone out and requires reconnecting Vercel and GitHub.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_SESSION_SECRET=
# Public HTTPS origin of the panel (trusted origin for same-origin checks, widget and sitemap URLs).
MASTER_PUBLIC_URL=https://panel.roistation.example

# ── Storage (required) ───────────────────────────────────────────────────────
# Connect a PRIVATE Vercel Blob store to the project. On Vercel, BLOB_STORE_ID plus the
# managed VERCEL_OIDC_TOKEN are set automatically; the static token is the local fallback.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ── Site catalog ─────────────────────────────────────────────────────────────
# Built-in client sites as a JSON array. Inlined at build time: redeploy after changing.
# Leave empty to run with the fictional demo catalog (lib/sites.ts → demoSites).
# Fields: id (a-z0-9-), name, domain, optional project, sector, initials, color, business.
# Example:
# NEXT_PUBLIC_ROISTATION_SITES=[{"id":"zeytinlik-restoran","name":"Zeytinlik Restoran","project":"zeytinlik-restoran","domain":"zeytinlik.example","sector":"Restoran","business":{"schemaType":"Restaurant","locality":"Foça","region":"İzmir"}}]
NEXT_PUBLIC_ROISTATION_SITES=
# Vercel projects that are never auto-imported or published to (comma separated).
NEXT_PUBLIC_ROISTATION_EXCLUDED_PROJECTS=
# Optional extra production hostnames per site id; arbitrary third-party URLs are never accepted.
SITE_ALLOWED_HOSTS_JSON={"zeytinlik-restoran":["zeytinlik.example","www.zeytinlik.example"]}
# Optional business data for LocalBusiness/Restaurant schema and the NAP box.
# Only these values are used for phone, address and hours — nothing is invented.
SITE_BUSINESS_JSON={"zeytinlik-restoran":{"telephone":"+90 232 000 00 00","streetAddress":"Liman Caddesi 1","postalCode":"35680","openingHours":["Mo-Su 09:00-23:00"],"servesCuisine":["Balık","Meze"],"sameAs":["https://www.instagram.com/zeytinlik.example"],"services":[{"name":"Rezervasyon","path":"/rezervasyon"}]}}

# ── Content generation (optional; at least one provider for live generation) ─
# Anthropic is tried first, OpenAI second. Without either, drafts are marked demo and cannot be published.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only for an Anthropic key scoped to multiple workspaces.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# ── Client-site cache purge (recommended) ────────────────────────────────────
# Same value (≥ 32 chars) on the panel and every site; withdraw/delete then purges site caches instantly.
ROISTATION_REVALIDATE_SECRET=

# ── Vercel integration (optional) ────────────────────────────────────────────
# Either set a token here, or connect once from the panel (stored encrypted in the Blob store).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Daily jobs in vercel.json send it as a Bearer token. At least 16 characters.
CRON_SECRET=
# Signing secret of an optional Vercel webhook (deployment.*, project.*) for instant updates.
VERCEL_WEBHOOK_SECRET=

# ── SEO & GEO Center (optional) ──────────────────────────────────────────────
# Google PageSpeed Insights key: higher quota for Core Web Vitals.
PAGESPEED_API_KEY=
# Fine-grained GitHub token for optimization pull requests (Contents + Pull requests: read/write),
# or connect once from Settings.
GITHUB_TOKEN=

# ── Testing only ─────────────────────────────────────────────────────────────
# API base overrides used by local fixtures; leave unset in production.
# VERCEL_API_URL=https://api.vercel.com
# GITHUB_API_URL=https://api.github.com
