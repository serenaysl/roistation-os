{
  "name": "roistation-master-panel",
  "version": "1.7.0",
  "description": "Central control panel for publishing SEO/GEO content and forms to a portfolio of Next.js sites on Vercel, with live site audits and pull-request based optimization.",
  "author": "Serenay Uslu",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:managed": "node -r ./scripts/network-shim.cjs node_modules/next/dist/bin/next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "node scripts/integration.mjs",
    "verify": "npm run build && npm run typecheck && npm run smoke && npm run test:integration"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.2"
  }
}
